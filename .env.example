# Proveedor de LLM: gemini | groq | auto (por defecto: auto). "deepseek" se acepta como alias legacy de groq.
LLM_PROVIDER=auto

# Gemini API
GEMINI_API_KEY=tu_clave_de_google_ai_studio
GEMINI_MODEL=gemini-3.6-flash
# Opcional: varias keys separadas por comas (rota ante 429) y varios modelos (fallback en orden).
# GEMINI_API_KEYS=key1,key2
# GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview

# Groq API (secundario: entra cuando Gemini se queda sin cuota. Compatible OpenAI: https://api.groq.com/openai/v1)
GROQ_API_KEY=tu_clave_de_groq_gsk_...
GROQ_MODEL=openai/gpt-oss-120b
# GROQ_BASE_URL=https://api.groq.com/openai/v1

MCP_ENABLED=false
# Optional read-only MongoDB MCP server (credentials stay on the server).
MONGODB_URI=mongodb+srv://<usuario>:<clave>@cluster0.iqh0irh.mongodb.net/?retryWrites=true&w=majority&appName=GlintMesh
MONGODB_DATABASE=finapp
# Optional async MongoDB persistence layer (mongo_store.py, Motor). Without
# MONGODB_URI the app uses file-based storage (users.json, uploads/).
# MONGODB_DB=glintmesh
